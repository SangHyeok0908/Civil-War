{
  "name": "civil-war",
  "private": true,
  "version": "0.2.0-provisional",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/build-collector.mjs && pnpm build:web",
    "dev:collector": "pnpm build && electron apps/collector/dist/main.cjs",
    "test:probe": "node --test tools/lcu-probe/*.test.mjs",
    "format": "prettier --write apps/collector/src apps/web/src apps/web/index.html \"apps/*/package.json\" apps/collector/electron-builder.json packages tests scripts \"tools/lcu-probe/*.mjs\" .github .vscode infra \"*.config.ts\" .prettierrc.json package.json pnpm-workspace.yaml tsconfig.json",
    "format:check": "prettier --check apps/collector/src apps/web/src apps/web/index.html \"apps/*/package.json\" apps/collector/electron-builder.json packages tests scripts \"tools/lcu-probe/*.mjs\" .github .vscode infra \"*.config.ts\" .prettierrc.json package.json pnpm-workspace.yaml tsconfig.json",
    "format:java": "node scripts/format-java.mjs spotlessApply",
    "format:java:check": "node scripts/format-java.mjs spotlessCheck",
    "build:web": "vite build --config vite.web.config.ts",
    "test:web": "playwright test -c playwright.web.config.ts",
    "docs:check": "node scripts/docs.mjs check",
    "docs:index": "node scripts/docs.mjs index",
    "test:docs": "node --test scripts/docs.test.mjs",
    "package:collector": "node scripts/package-collector.mjs",
    "verify:collector-release": "node scripts/package-collector.mjs --verify",
    "test:collector-release": "node --test scripts/collector-release.test.mjs scripts/nsis-integrity.test.mjs scripts/repair-uninstaller.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
