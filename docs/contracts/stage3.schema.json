{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civil-war.invalid/contracts/stage3.schema.json",
  "title": "Civil War stage 3 provisional HTTP contract",
  "description": "Current stage 3 schemas; ingest schemaVersion 1 remains unchanged. Stage 1 schema is a historical snapshot.",
  "$comment": "Public evaluation fields extend the stage 1 DTO. See stage3-api.md. This is not a verified Windows/LCU operational contract.",
  "$defs": {
    "Role": {
      "enum": [
        "TOP",
        "JUNGLE",
        "MIDDLE",
        "BOTTOM",
        "UTILITY"
      ]
    },
    "State": {
      "enum": [
        "pending",
        "registered",
        "canceled"
      ]
    },
    "MatchKey": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,16}:[0-9]{1,30}$"
    },
    "SubmissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Roles": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": {
        "$ref": "#/$defs/Role"
      }
    },
    "ParticipantRecord": {
      "type": "object",
      "properties": {
        "puuid": {
          "type": "string",
          "minLength": 1
        },
        "teamId": {
          "enum": [
            100,
            200
          ]
        },
        "win": {
          "type": "boolean"
        },
        "championId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "kills": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deaths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assists": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "championDamage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "damageTaken": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "laneCs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neutralCs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "goldEarned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "visionScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objectiveDamage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turretDamage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minItems": 7,
          "maxItems": 7
        }
      },
      "required": [
        "puuid",
        "teamId",
        "win",
        "championId",
        "kills",
        "deaths",
        "assists",
        "championDamage",
        "damageTaken",
        "laneCs",
        "neutralCs",
        "goldEarned",
        "visionScore",
        "objectiveDamage",
        "turretDamage",
